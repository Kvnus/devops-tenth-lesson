// Job 1: build Docker-image with teg in build node and push in registry.
// Variables in jenkins/pipeline.env
def loadEnvFile(String path) {
    def cfg = [:]
    readFile(path).split('\n').each { line ->
        line = line.trim()
        if (line && !line.startsWith('#') && line.contains('=')) {
            def i = line.indexOf('=')
            cfg[line.substring(0, i).trim()] = line.substring(i + 1).trim()
        }
    }
    return cfg
}

properties([parameters([
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Тег образа (пусто = IMAGE_TAG из pipeline.env)')
])])

def cfg
node {
    checkout scm
    cfg = loadEnvFile('jenkins/pipeline.env')
}

node(cfg.BUILD_NODE_LABEL) {
    def tag = params.IMAGE_TAG ?: cfg.IMAGE_TAG
    def image = "${cfg.REGISTRY}/${cfg.IMAGE_NAME}:${tag}"

    stage('Checkout') {
        checkout scm
    }
    stage('Build image') {
        sh "docker build -f '${cfg.DOCKERFILE}' -t '${image}' ."
    }
    stage('Push image') {
        withCredentials([usernamePassword(credentialsId: cfg.REGISTRY_CREDENTIALS_ID,
                usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
            sh """
                echo "\$REG_PASS" | docker login '${cfg.REGISTRY}' -u "\$REG_USER" --password-stdin
                docker push '${image}'
                docker logout '${cfg.REGISTRY}'
            """
        }
    }
    echo "Pushed ${image}"
}
