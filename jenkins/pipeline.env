# Единый файл переменных для обеих Jenkins-задач (формат KEY=VALUE, # - комментарий)

# --- Docker registry ---
REGISTRY=localhost:5001
IMAGE_NAME=java-demo
# Тег по умолчанию (можно переопределить параметром IMAGE_TAG при запуске задачи)
IMAGE_TAG=v1.0
# ID credentials (Username with password) в Jenkins для логина в registry
REGISTRY_CREDENTIALS_ID=registry-creds

# --- Ноды Jenkins (метки агентов) ---
BUILD_NODE_LABEL=build
PROD_NODE_LABEL=prod

# --- Запуск контейнера на проде ---
CONTAINER_NAME=java-demo
HOST_PORT=8081
CONTAINER_PORT=8080
RESTART_POLICY=unless-stopped

# --- Репозиторий / сборка ---
DOCKERFILE=Dockerfile

# --- Проверка после запуска (хост, где доступен HOST_PORT; для удалённой prod-ноды обычно localhost) ---
HEALTH_HOST=host.docker.internal
